rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tarunthakur21611@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public catalog collections - Anyone can view, only verified Admin can manage
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId);
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(galleryId);
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(testimonialId);
    }

    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(contentId);
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingsId);
    }

    // Enquiries: Prospective customers can submit a quote enquiry; only Admin can read, update status, or delete
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() > 0 && incoming().phone.size() <= 30;
      allow read, update, delete: if isAdmin() && isValidId(enquiryId);
    }

    // Admin whitelist collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
